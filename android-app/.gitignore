# Node
/node_modules/

# Generated web bundle (rebuild with: npm run bundle)
/www/

# Capacitor-copied web assets (regenerated by cap sync)
/android/app/src/main/assets/public/

# Gradle / Android build outputs
/android/.gradle/
/android/build/
/android/app/build/
/android/capacitor-cordova-android-plugins/build/
/android/local.properties

# Secrets — NEVER commit
/android/keystore.properties
/android/keystore.properties.*
/keystore/
**/keystore/
*.keystore
*.jks
*.p12
*.pem
*.key
KEYSTORE-CREDENTIALS*.txt
.env
.env.*

# Signed artifacts (signed with the upload key; never version them)
*.aab
*.apk
*.idsig

.DS_Store
